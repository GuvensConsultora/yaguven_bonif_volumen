<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_volume_discount" model="ir.ui.view">
        <field name="name">res.partner.form.volume.discount</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page string="Bonificación por volumen" name="volume_discount"
                      invisible="parent_id" groups="account.group_account_invoice">
                    <p class="text-muted">
                        Escala particular del cliente. Si tiene tramos cargados en una empresa,
                        reemplaza a la escala de la lista de precios que tiene asignada. Sin tramos,
                        rige la de su lista (si la lista tiene activada la bonificación).
                    </p>
                    <field name="vd_tier_ids" nolabel="1"
                           context="{'default_partner_id': id, 'default_pricelist_id': False}">
                        <list editable="bottom">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount_from"/>
                            <field name="percent"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
