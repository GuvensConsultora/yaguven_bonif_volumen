<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compras del mes del cliente debajo del contacto: en borrador, en vivo (incluye esta
         factura); confirmada, lo que se fijó al confirmar. Sólo para clientes con escala. -->
    <record id="view_move_form_volume_discount" model="ir.ui.view">
        <field name="name">account.move.form.volume.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="vd_has_scale" invisible="1"/>
                <field name="vd_month_volume_preview"
                       invisible="state != 'draft' or not vd_has_scale"/>
                <field name="vd_next_tier_text"
                       invisible="state != 'draft' or not vd_next_tier_text"/>
                <field name="vd_month_volume" string="Comprado en el mes"
                       invisible="state == 'draft' or not vd_month_volume"/>
                <!-- NC de bonificación: va por período, no asociada a una factura (RG 4540). -->
                <label for="vd_period_start" string="Período ajustado"
                       invisible="not vd_period_start"/>
                <div class="d-flex gap-2" invisible="not vd_period_start">
                    <field name="vd_period_start" class="oe_inline"/>
                    <span>al</span>
                    <field name="vd_period_end" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
