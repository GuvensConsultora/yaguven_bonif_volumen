<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compras del mes del cliente debajo del contacto: en borrador, en vivo (incluye esta
         factura); confirmada, lo que se fijó al confirmar. Sólo para clientes con escala. -->
    <record id="view_move_form_volume_discount" model="ir.ui.view">
        <field name="name">account.move.form.volume.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="vd_has_scale" invisible="1"/>
                <field name="vd_month_volume_preview"
                       invisible="state != 'draft' or not vd_has_scale"/>
                <field name="vd_month_volume" string="Comprado en el mes"
                       invisible="state == 'draft' or not vd_month_volume"/>
            </xpath>
        </field>
    </record>
</odoo>
